# ==========================================
# AIMDA Docker Environment Configuration
# ==========================================
# Copy this file to docker.env and fill in the values:
#   cp docker.env.example docker.env
# Then edit docker.env with the correct credentials.
# docker.env is in .gitignore and will NOT be committed.

# Application server port
SERVER_PORT=8030

# PostgreSQL database connection
# Hostname must match the container name on the omnikron-docker-net network
DB_URL=jdbc:postgresql://aimda-postgres:5432/aimda
DB_USERNAME=admin
DB_PASSWORD=your_password_here

# Prediction Core service
# Hostname must match the container name on the omnikron-docker-net network
CORE_BASE_URL=http://omnikron-core-ai-medical-diagnostics
CORE_PORT=5000